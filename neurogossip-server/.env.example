# Neurogossip server configuration.
#
# Copy this file to `.env` (next to the package, or in the working directory you
# launch `neurogossip-server` from) and edit the values. The server loads `.env` on
# startup; command-line flags override these, and real process environment
# variables override the file.
#
#   cp .env.example .env

# --- Network ---------------------------------------------------------------
# Address to bind the WebSocket server to: 127.0.0.1, localhost, a specific IP,
# or 0.0.0.0 for all interfaces.
NEUROGOSSIP_SERVER_BIND=0.0.0.0
NEUROGOSSIP_SERVER_PORT=8966

# --- Logging ---------------------------------------------------------------
# Path to the rotating debug log file. Parent directories are created on startup.
NEUROGOSSIP_SERVER_LOG=logs/neurogossip-server.log
# Rotate when the log file reaches this size. Suffixes: B, KB, MB, GB (case-
# insensitive; the trailing B is optional). Examples: 250MB, 1GB, 262144000.
# (The legacy typo'd key NUEROGOSSIP_SERVER_LOG_SIZE is also accepted.)
NEUROGOSSIP_SERVER_LOG_SIZE=250MB
# Console (stderr) log level. The file ALWAYS logs at DEBUG (all communications and
# technical details). One of: debug, info, warning, error, critical.
NEUROGOSSIP_SERVER_LOG_LEVEL=debug
# Number of archived log files to keep after rotation (.log.1, .log.2, ...).
NEUROGOSSIP_SERVER_LOG_BACKUP_COUNT=5

# --- CLI / auth ------------------------------------------------------------
# Set to true to enable the ANSI single-window CLI message view.
NEUROGOSSIP_SERVER_CLI=false
# Require agents to present the shared secret on register.
NEUROGOSSIP_SERVER_AUTH_REQUIRED=false
NEUROGOSSIP_SERVER_AUTH_SECRET=

# --- Heartbeat / liveness --------------------------------------------------
# App-level heartbeat: server sends a JSON "ping" every N seconds and declares
# the agent offline after NEUROGOSSIP_SERVER_MAX_MISSED unanswered pings.
NEUROGOSSIP_SERVER_HEARTBEAT_INTERVAL=15
NEUROGOSSIP_SERVER_MAX_MISSED=3
# websockets protocol keepalive: the server sends a PING every WS_PING_INTERVAL
# seconds and closes the connection if no PONG arrives within WS_PING_TIMEOUT.
# Keep WS_PING_TIMEOUT generous (>= the app-heartbeat window) so agents that block
# their event loop for a long LLM turn (>10s) aren't falsely reaped — a too-short
# timeout was closing all agents simultaneously and triggering reconnect storms.
# Half-open sockets are still reaped within ~INTERVAL+TIMEOUT seconds.
NEUROGOSSIP_SERVER_WS_PING_INTERVAL=20
NEUROGOSSIP_SERVER_WS_PING_TIMEOUT=45
# Seconds to wait for a pong when probing a stale "online" session on reconnect
# before evicting it.
NEUROGOSSIP_SERVER_LIVENESS_TIMEOUT=2

# --- Routing / delivery ----------------------------------------------------
NEUROGOSSIP_SERVER_DELIVERY_TIMEOUT=30
NEUROGOSSIP_SERVER_MAX_MESSAGE_BYTES=1048576
# Per-connection outbound frame queue size. "Large message queues" with explicit
# drop-oldest backpressure — bursts are absorbed instead of head-of-line blocking the
# sender. On overflow the oldest frame is dropped and logged at ERROR.
NEUROGOSSIP_SERVER_OUTBOUND_QUEUE_SIZE=10000

# --- Rate limiting ---------------------------------------------------------
# Per-agent token bucket (msgs/min) and per-pair sliding window (msgs/min).
NEUROGOSSIP_SERVER_RATE_LIMIT_AGENT=60
NEUROGOSSIP_SERVER_RATE_LIMIT_PAIR=20

# --- Loop prevention / conversations ---------------------------------------
NEUROGOSSIP_SERVER_MAX_CONVERSATION_DEPTH=20
NEUROGOSSIP_SERVER_CIRCUIT_BREAKER_WINDOW=60
NEUROGOSSIP_SERVER_CIRCUIT_BREAKER_MAX=30
NEUROGOSSIP_SERVER_CIRCUIT_BREAKER_COOLDOWN=120

# --- Presence --------------------------------------------------------------
# Seconds to debounce presence broadcasts (0 = immediate).
NEUROGOSSIP_SERVER_PRESENCE_DEBOUNCE=1